# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- Auth.js (v5 reads AUTH_* names) ---
# Generate AUTH_SECRET with: npx auth secret
# AUTH_URL=  (leave unset locally and on Vercel; an empty value disables host trust)
AUTH_SECRET=

# --- OAuth providers ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ORCID_ID=
AUTH_ORCID_SECRET=
# https://sandbox.orcid.org while on the sandbox client, https://orcid.org in production
AUTH_ORCID_ISSUER=https://sandbox.orcid.org

# --- AI (optional, stretch goal for the Content Generator) ---
ANTHROPIC_API_KEY=

# --- Supabase (Postgres + Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---
# Public contact address shown on the About, Privacy and Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Absolute site URL used in generated social captions and the RSS feed (production).
SITE_URL=
